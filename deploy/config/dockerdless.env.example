# dockerdless environment configuration example.
#
# Environment-variable equivalent of deploy/config/dockerdless.yaml.
# Source it, or copy the exports into your service manager or shell:
#   . deploy/config/dockerdless.env.example
#   ./bin/dockerdless
#
# Precedence is environment > config file > built-in defaults. An environment
# variable set to an empty string is treated as unset, so unset a variable to
# let the file or default value apply.

# Path to a YAML config file. This variable is NOT one of the DOCKERDLESS_* keys;
# the daemon reads it directly. Uncomment to load a file and enable hot reload.
# export DOCKERDLESS_CONFIG_FILE=/etc/dockerdless/dockerdless.yaml

# Docker-compatible Unix socket. (default: /var/run/dockerdless.sock)
export DOCKERDLESS_SOCKET_PATH=/run/dockerdless/dockerdless.sock

# Log level: debug, info, warn, error, dpanic, panic, or fatal. (default: info)
export DOCKERDLESS_LOG_LEVEL=info

# OpenTelemetry service.name resource. (default: dockerdless)
export DOCKERDLESS_OTEL_SERVICE_NAME=dockerdless

# OTLP gRPC endpoint. Empty disables OpenTelemetry export. (default: empty)
export DOCKERDLESS_OTEL_ENDPOINT=

# containerd namespace. (default: moby, aligned to default at startup)
export DOCKERDLESS_CONTAINERD_NAMESPACE=default

# containerd Unix socket. (default: /run/containerd/containerd.sock)
export DOCKERDLESS_CONTAINERD_SOCKET=/run/containerd/containerd.sock

# CNI network config directory. (default: /etc/cni/net.d)
export DOCKERDLESS_CNI_CONFIG_DIR=/etc/cni/net.d

# CNI plugin directory. (default: /opt/cni/bin)
export DOCKERDLESS_CNI_PLUGIN_DIR=/opt/cni/bin

# BuildKit daemon Unix socket. (default: /run/buildkit/buildkitd.sock)
export DOCKERDLESS_BUILDKIT_SOCKET=/run/buildkit/buildkitd.sock

# Default container stop timeout. Must be greater than zero. (default: 10s)
export DOCKERDLESS_DEFAULT_STOP_TIMEOUT=10s

# Per-request timeout. Must be greater than zero. (default: 30s)
export DOCKERDLESS_REQUEST_TIMEOUT=30s

# Reserved forward-compatibility flags; no effect today. (default: false)
export DOCKERDLESS_ENABLE_CRI=false
export DOCKERDLESS_ENABLE_ROOTLESS=false
