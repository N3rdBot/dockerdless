# dockerdless service environment.
#
# Install as /etc/dockerdless/dockerdless.env, mode 0600, owned by root. The
# unit loads it with EnvironmentFile=-/etc/dockerdless/dockerdless.env.
#
# Every DOCKERDLESS_* variable can also be set in the YAML file named by
# DOCKERDLESS_CONFIG_FILE. Environment variables take precedence over the file.
# See docs/configuration.md for the full settings reference.

# Docker API Unix socket. Matches RuntimeDirectory=dockerdless in the unit, so
# the socket lands in /run/dockerdless (mode 0750). The socket itself is created
# 0660, owned by the daemon uid (root when run through this unit). Only root and
# the socket's group can connect.
DOCKERDLESS_SOCKET_PATH=/run/dockerdless/dockerdless.sock

# YAML configuration file. Setting this enables file loading AND hot reload:
# the daemon watches the containing directory and applies a valid log-level
# change without a restart. This file MUST exist before start. If the path is
# set but unreadable, the daemon exits non-zero with
# "load configuration: read configuration file ...". Keep at least log-level.
DOCKERDLESS_CONFIG_FILE=/etc/dockerdless/config.yaml

# Structured (JSON) log level: debug, info, warn, error, dpanic, panic, fatal.
# Logs go to stderr, which systemd captures in the journal. Changes to every
# other setting log "configuration change requires restart".
DOCKERDLESS_LOG_LEVEL=info

# containerd namespace. The built-in default is "moby", which the daemon aligns
# to "default" to match the local BuildKit worker; any other value is used
# as-is. Images are only visible to the runtime store when the daemon and the
# BuildKit worker share a namespace. Uncomment only if BuildKit's worker uses a
# different namespace.
#DOCKERDLESS_CONTAINERD_NAMESPACE=default
